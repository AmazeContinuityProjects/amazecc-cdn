{
  "faculty_master_constructor": {
    "version": "1.0.0",
    "description": "Master faculty constructor: sync directorycc + chennai, fetch vitfac catalog, build combined + all-data catalogs",
    "sync": {
      "directorycc": {
        "base_url": "https://directorycc.vit.ac.in/api/faculty/",
        "probe_buffer": 600,
        "recheck_invalid_sample": 200,
        "concurrency": 15,
        "request_timeout": 25,
        "max_retries": 6,
        "backoff_base": 1.7
      },
      "chennai": {
        "base": "https://chennai.vit.ac.in",
        "wp_types_endpoint": "/wp-json/wp/v2/types",
        "per_page": 100,
        "concurrency": 12,
        "request_timeout": 25,
        "max_retries": 6,
        "backoff_base": 1.7,
        "resolve_images": true
      }
    },
    "build": {
      "vitfac_catalog_url": "https://cache.amazecc.com/faculty",
      "cdn_base": "https://cdn.amazecc.com",
      "outputs": [
        "faculty_combined_v1.json",
        "faculty_all_data_v1.json",
        "vitfac_catalog_v1.json"
      ]
    },
    "kv": {
      "cache_namespace_id": "3cf003b8421b4de0a8bc54776f1df337",
      "cache_namespace_binding": "CACHE",
      "combined_key": "faculty_combined_v1",
      "all_data_key": "faculty_all_data_v1",
      "vitfac_key": "faculty_list_v1"
    },
    "state": {
      "sync_root": "sync/state",
      "output_root": "state"
    }
  }
}
